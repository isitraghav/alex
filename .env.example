# Copy to .env and fill. .env is gitignored — never commit real keys.

# --- NVIDIA NIM (required) --- build.nvidia.com -> get API key
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Free data APIs ---
FRED_API_KEY=                       # fred.stlouisfed.org/docs/api/api_key.html
FINNHUB_API_KEY=                    # finnhub.io (free tier)
SEC_USER_AGENT=alex/0.1 (you@example.com)   # SEC requires a real contact

# --- Storage (defaults match docker-compose) ---
POSTGRES_DSN=postgresql://fintel:fintel@postgres:5432/fintel
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fintelpass

STORAGE_BEST_EFFORT=true            # false = crash if a DB is down
