# Copy to .env and fill. .env is gitignored — never commit real keys.

# --- How to reach the models: ONE of these is enough ---
# Claude API: platform.claude.com -> API keys (billed separately from a claude.ai Pro plan)
ANTHROPIC_API_KEY=
# OpenRouter: openrouter.ai -> Keys (same Claude models, routed through OpenRouter)
OPENROUTER_API_KEY=
# claude-code: no key here; uses the local Claude Code CLI login (`claude`, e.g. a Pro plan)
LLM_PROVIDER=auto              # auto | anthropic | openrouter | claude-code (auto: Claude key, else OpenRouter)
OPENROUTER_MODELS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5,anthropic/claude-opus-5.5

# --- Bench ---
BENCH_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5   # comma-separated
LLM_EFFORT=medium              # low|medium|high|xhigh|max, same for every model
LLM_MAX_TOKENS=16000
LLM_MAX_RETRIES=6              # backoff retries on 429/5xx
PROMPT_VARIANT=default         # minimal|default|grounded (comma-separated for several)
REQUEST_DELAY_S=0              # seconds between cases
RESULTS_DIR=results

# --- Only needed for `alex --live` (default run uses frozen fixtures) ---
FRED_API_KEY=
FINNHUB_API_KEY=
SEC_USER_AGENT=alex/0.3 (you@example.com)

# --- Knowledge graph (frozen runs always use the built-in in-memory graph) ---
KG_BACKEND=memory              # memory | neo4j  (neo4j: live mode and the alex-kg CLI)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                # also used by `docker compose --profile graph up neo4j`
NEO4J_DATABASE=neo4j
