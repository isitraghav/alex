# Copy to .env and fill. .env is gitignored — never commit real keys.

# --- NVIDIA NIM (required) --- build.nvidia.com -> get API key
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Bench ---
BENCH_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b   # comma-separated
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
RESULTS_DIR=results
LLM_MAX_RETRIES=6              # backoff retries on 429/5xx
REQUEST_DELAY_S=0              # seconds between cases

# --- Only needed for `alex --live` (default run uses frozen fixtures) ---
FRED_API_KEY=
FINNHUB_API_KEY=
SEC_USER_AGENT=alex/0.2 (you@example.com)
